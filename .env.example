# Provider:model convention, read by langchain.chat_models.init_chat_model
# Start with Ollama for cheap local debugging, switch to OpenAI later -
# this line is the only thing that needs to change to do that.
AGENT_MODEL=ollama:llama3.1
 
# knowledge-mcp-server's MCP endpoint - no auth required yet (deferred
# alongside mTLS/Docker/k8s, same decision as when that server was built)
MCP_SERVER_URL=http://localhost:8002/mcp
 
# Only needed once AGENT_MODEL is switched to an openai:* model
# OPENAI_API_KEY=
LANGFUSE_SECRET_KEY = dcsdcd
LANGFUSE_PUBLIC_KEY = scds
LANGFUSE_BASE_URL = dcsc