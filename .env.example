# Provider:model convention, read by langchain.chat_models.init_chat_model
AGENT_MODEL=openai:gpt-4o-mini
# Used only if the primary model call fails after retries (outage / 429 /
# timeout). Use a different provider than AGENT_MODEL. Leave empty to disable.
# AGENT_FALLBACK_MODEL=anthropic:claude-haiku-4-5
AGENT_LLM_TIMEOUT_SECONDS=45
AGENT_LLM_MAX_RETRIES=2
AGENT_REQUEST_TIMEOUT_SECONDS=120

# knowledge-mcp-server's MCP endpoint. Use 127.0.0.1, not localhost:
# "localhost" can add seconds per connection (IPv6 tried first).
MCP_SERVER_URL=http://127.0.0.1:8002/mcp

# development | production. Production refuses to start without SECURITY_API_KEY.
ENV=development
# Clients send this in the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECURITY_API_KEY=
SECURITY_RATE_LIMIT_PER_MINUTE=20

# Provider keys for whichever models are configured above
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: Langfuse prompt management / tracing
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Optional: Postgres checkpointer for persistent conversation memory
# POSTGRES_CHECKPOINT_URL=postgresql://user:password@127.0.0.1:5432/dbname